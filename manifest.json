{
  "manifest_version": 3,
  "name": "Yutu Labs",
  "version": "1.3.0",
  "description": "Open YouTube videos in floating windows. Speed controls, auto-close, and distraction-free viewing.",
  "permissions": [
    "storage",
    "system.display",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/youtube-content.js", "content/hider.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://google.com/*", "*://*.google.com/*"],
      "exclude_matches": ["*://*.youtube.com/*"],
      "js": ["content/external-content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ]
}
