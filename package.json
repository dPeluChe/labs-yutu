{
  "name": "yutu-extension",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome extension for YouTube enhancements",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint . && stylelint \"**/*.css\" --ignore-path .gitignore",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "type": "module"
}
